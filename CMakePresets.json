{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2026-x64",
      "displayName": "Windows VS2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/windows/windows-vs2026-x64",
      "cacheVariables": {
        "CMAKE_GENERATOR_INSTANCE": "D:/VS2026/2026",
        "CMAKE_CXX_STANDARD": "23",
        "BUILD_TESTING": "ON",
        "MINI_ENABLE_TLS": "OFF"
      }
    },
    {
      "name": "windows-vs2026-x64-release",
      "displayName": "Windows VS2026 x64 Release",
      "inherits": "windows-vs2026-x64",
      "binaryDir": "${sourceDir}/out/windows/windows-vs2026-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2026-x64",
      "configurePreset": "windows-vs2026-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2026-x64-release",
      "configurePreset": "windows-vs2026-x64-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-vs2026-x64",
      "configurePreset": "windows-vs2026-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-vs2026-x64",
      "steps": [
        {
          "type": "configure",
          "name": "windows-vs2026-x64"
        },
        {
          "type": "build",
          "name": "windows-vs2026-x64"
        },
        {
          "type": "test",
          "name": "windows-vs2026-x64"
        }
      ]
    }
  ]
}
